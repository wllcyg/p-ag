# ==========================================
# 教师说课 PPT 智能生成系统 - 服务端环境变量模板
# ==========================================

# ------------------------------------------
# 1. 核心大模型 API 配置 (必填)
# ------------------------------------------
# DeepSeek 官方 API 密钥 (用于 R1 思考流与 V3 结构化转换)
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
# API Base URL (默认: https://api.deepseek.com，若走硅基流动等中转可改为 https://api.siliconflow.cn/v1)
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ------------------------------------------
# 2. Supabase 认证与数据库配置 (必填)
# ------------------------------------------
# Supabase 项目 URL (例如: https://xxxx.supabase.co)
SUPABASE_URL=https://your-project.supabase.co
# Supabase 客户端公钥 (Publishable Key / Anon Key)
SUPABASE_ANON_KEY=your-supabase-publishable-key
# Supabase 服务端密钥 (Secret Key / Service Role Key，后端管理权限)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-key
# PostgreSQL 数据库连接串 (用于 ORM 数据存储)
DATABASE_URL=postgresql://postgres.your-project:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres

# ------------------------------------------
# 3. 检索增强与 RAG 配置 (按需启用)
# ------------------------------------------
# 硅基流动 API Key (用于云端免部署调用 BGE-M3 向量化与 BGE-Reranker 精排)
SILICONFLOW_API_KEY=sk-your-siliconflow-api-key
# 实时联网搜索兜底 API Key (可选: Tavily / Serper)
TAVILY_API_KEY=tvly-your-tavily-api-key

# ------------------------------------------
# 4. 缓存与存储 (可选)
# ------------------------------------------
# Redis 语义缓存连接串 (推荐 Upstash Serverless Redis: rediss://default:xxx@xxx.upstash.io:6379)
REDIS_URL=

# ------------------------------------------
# 5. 服务基础配置
# ------------------------------------------
NODE_ENV=development
# 默认端口 (HF Space 默认 7860)
PORT=7860
# 前端跨域白名单 (生产环境建议指定前端实际域名，如: https://your-domain.vercel.app，留空或 * 为全允许)
CORS_ORIGIN=*

# ------------------------------------------
# 6. Infisical 统一密钥管理配置 (Universal Auth / Service Token)
# ------------------------------------------
# Infisical 平台地址 (云端默认: https://app.infisical.com，自建填自建域名)
INFISICAL_SITE_URL=https://app.infisical.com
# 机器身份 Universal Auth (推荐)
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_PROJECT_ID=
# 拉取环境 (dev / staging / prod)
INFISICAL_ENV=dev
# 或者使用传统 Service Token
# INFISICAL_TOKEN=st.xxxx.xxxx


