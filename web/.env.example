# ==========================================
# 前端环境变量模板 (web/.env.example)
# ==========================================

# Supabase 项目 URL
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase 客户端匿名公钥
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# 后端 API 地址 (本地开发为 http://localhost:7860)
VITE_API_BASE_URL=http://localhost:7860
